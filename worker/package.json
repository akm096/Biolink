{
  "name": "biolink-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply biolink-db --local",
    "db:migrate": "wrangler d1 migrations apply biolink-db --remote",
    "db:seed:local": "wrangler d1 execute biolink-db --local --file=./seed.sql",
    "db:seed": "wrangler d1 execute biolink-db --remote --file=./seed.sql"
  },
  "devDependencies": {
    "wrangler": "^4.13.2"
  }
}
